# Google Analytics 4 (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense publisher ID (optional)
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Tracking provider: cainiao | auto | wordpress | 17track | trackingmore
# Cainiao is free, unlimited, no API key — same as WordPress “Cainiao (Free)” setting.
TRACKING_PROVIDER=cainiao

# Optional: TrackingMore API key — used to fetch ALL carrier logos via:
#   GET https://api.trackingmore.com/v4/couriers/all  (field: courier_logo)
# Run:  node scripts/fetch-carrier-logos.mjs
# Without a key, the script probes the public CDN (~60% coverage) and
# missing carriers show letter avatars in the UI.
# TRACKINGMORE_API_KEY=

# Optional cutover proxy while WordPress is still live:
# TRACKING_WP_AJAX_URL=https://everitracking.com/wp-admin/admin-ajax.php
# TRACKING_WP_NONCE=

# Optional paid APIs (only if you switch provider):
# TRACKING_PROVIDER=17track
# TRACKING_API_KEY=
